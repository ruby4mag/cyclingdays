# Copy to .env and fill in values:  cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real credentials.

# --- Application ---------------------------------------------------------
# development | test | production
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- API -----------------------------------------------------------------
API_PORT=8010
# Host interface the API is published on by docker compose.
# 127.0.0.1 = local only. Use 0.0.0.0 to expose on the LAN (add a firewall rule).
API_BIND_ADDRESS=127.0.0.1

# --- Web login ---------------------------------------------------------------
# Signs session cookies (at least 32 characters). Unset: random per process,
# so everyone is signed out on each restart.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# How long a sign-in lasts (hours, default 7 days).
AUTH_SESSION_HOURS=168
# Secure cookie flag. Leave unset to follow the request scheme; set true when
# served over HTTPS behind a proxy that doesn't pass X-Forwarded-Proto.
# AUTH_COOKIE_SECURE=true
# Users: python -m scripts.manage_users add <username>

# --- PostgreSQL ----------------------------------------------------------
# For running the app on the host (venv): localhost + published port 5434.
# Inside docker compose the app overrides these to db:5432 automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=cycling_coach
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Optional full URL that overrides the components above:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Container start-up behaviour
RUN_MIGRATIONS_ON_START=true

# --- Intervals.icu ---------------------------------------------------------
# API key and athlete id: Intervals.icu -> Settings -> Developer Settings.
# Auth is HTTP Basic with username "API_KEY" (handled by the app).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
# INTERVALS_BASE_URL=https://intervals.icu
# INTERVALS_TIMEOUT_SECONDS=30
# INTERVALS_MAX_RETRIES=4
# INTERVALS_BACKOFF_BASE_SECONDS=1
# INTERVALS_BACKOFF_MAX_SECONDS=60
# Days of history fetched on the first/--full sync (minimum 30). CTL needs
# 96 days of history before it is treated as authoritative.
INTERVALS_HISTORY_DAYS=180
# Incremental syncs re-fetch this many days before the previous window end.
INTERVALS_SYNC_OVERLAP_DAYS=7
INTERVALS_CALENDAR_FUTURE_DAYS=28
# Publish validated workouts to the Intervals.icu calendar after planning (Phase 5)
INTERVALS_PUBLISH_ENABLED=true

# --- Adaptive coaching / scheduler (Phase 7) ----------------------------------
# The scheduler service polls for new activities and plans the next day.
SCHEDULER_POLL_MINUTES=30
# Local time (athlete timezone) to plan and publish tomorrow
SCHEDULER_PLAN_TIME=20:00
ACTIVITY_LOOKBACK_DAYS=14
PLAN_HORIZON_DAYS=28

# --- OpenAI (Phase 4) -------------------------------------------------------
OPENAI_API_KEY=
# Any model your key can use that supports structured outputs. Every decision
# records the exact model the API reports. Dated snapshots (e.g.
# gpt-5.5-2026-04-23) pin behaviour; aliases may change underneath.
OPENAI_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=
# Generous: reasoning models can take minutes on a full planning prompt.
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_ATTEMPTS=3
# OPENAI_BACKOFF_BASE_SECONDS=2
# OPENAI_BACKOFF_MAX_SECONDS=60
# Correction rounds when model output fails validation, then safe fallback.
LLM_MAX_CORRECTIONS=2

# --- Notifications (Phase 9) ---------------------------------------------------
# Email alerts from the scheduler and the host watchdog (docs/OPERATIONS.md).
# Gmail: SMTP_HOST=smtp.gmail.com, port 587, starttls, SMTP_USERNAME = your
# address, SMTP_PASSWORD = an app password (Google account -> Security ->
# 2-Step Verification -> App passwords), not your normal password.
# Test: docker compose exec scheduler python -m scripts.notify_test
NOTIFY_EMAIL_ENABLED=false
# Comma-separated recipients
NOTIFY_EMAIL_TO=
# Sender; defaults to SMTP_USERNAME
# NOTIFY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# starttls (587) | ssl (465) | none (local relay only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Daily summary after planning (true) or problems only (false)
NOTIFY_DAILY_SUMMARY=true
# Re-send an unresolved problem after this many hours
NOTIFY_REPEAT_HOURS=12
# Failed polls in a row before Intervals.icu/sync problems are emailed
NOTIFY_POLL_FAILURE_THRESHOLD=2

# --- Athlete seed values (used only by scripts/seed_athlete_profile.py) ----
# Stored in the database on first seed; the DB profile is authoritative after that.
ATHLETE_SLUG=primary
ATHLETE_DISPLAY_NAME=Athlete
ATHLETE_FTP_WATTS=175
ATHLETE_WEIGHT_KG=86
ATHLETE_HEIGHT_CM=172
ATHLETE_AGE_YEARS=46
ATHLETE_EXPERIENCE_LEVEL=intermediate
ATHLETE_PRIMARY_OBJECTIVE=1200 km brevet / ultra-endurance cycling
ATHLETE_SECONDARY_OBJECTIVE=FTP improvement
ATHLETE_TIMEZONE=Asia/Kolkata
ATHLETE_INDOOR_PLATFORM=icTrainer
ATHLETE_WEARABLE=COROS
